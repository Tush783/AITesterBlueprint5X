<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Login Suite" verbose="1">
    <parameter name="baseUrl" value="https://login.salesforce.com/?locale=in"/>
    <parameter name="timeoutSeconds" value="20"/>
    <test name="Salesforce Valid Login Tests">
        <classes>
            <class name="com.salesforce.tests.ValidLoginTest"/>
        </classes>
    </test>
    <test name="Salesforce Invalid Login Tests">
        <classes>
            <class name="com.salesforce.tests.InvalidLoginTest"/>
        </classes>
    </test>
</suite>
