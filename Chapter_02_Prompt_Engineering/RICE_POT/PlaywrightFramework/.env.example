# Copy this file to .env and fill in the values. .env is not committed to git.

# Application address and login route
BASE_URL=https://app.wingify.com
LOGIN_PATH=/#/login

# Real Wingify account for the successful-login test (leave empty to skip that test)
WINGIFY_EMAIL=
WINGIFY_PASSWORD=

# Maximum wait for elements, in milliseconds
TIMEOUT_MS=20000

# true = no browser window (default), false = visible browser
HEADLESS=true
